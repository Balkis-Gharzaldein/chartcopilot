# ChartCopilot environment — copy to .env and fill in your keys (never commit .env)
# At least one provider key required for LLM mode; without any key the app runs in deterministic mode
# Frontend shows "LLM · on" vs "Deterministic" based on /api/health -> llm_available

# — Gemini (free tier) — new keys start with AQ. (old AIza... still accepted) —
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.REPLACE_WITH_YOUR_GEMINI_API_KEY_FROM_AISTUDIO
# Alternative name also accepted by llm.py (GEMINI_API_KEY or GOOGLE_API_KEY):
# GOOGLE_API_KEY=AQ.REPLACE_WITH_YOUR_GEMINI_API_KEY

# — Optional Gemini model override —
# GEMINI_MODEL=gemini-2.5-flash   # default in llm.py; override if needed

# — Other providers (optional; Anthropic preferred if multiple keys are set) —
# ANTHROPIC_API_KEY=sk-ant-...REPLACE_WITH_ANTHROPIC_KEY
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=sk-proj-...REPLACE_WITH_OPENAI_KEY
# OPENAI_MODEL=gpt-4o-mini

# Notes:
# - Keep .env private and gitignored — do not commit real keys. This .env.example is safe to commit.
# - AQ. is the new secure Gemini key format (AIza is legacy for Maps/YouTube, still accepted).
